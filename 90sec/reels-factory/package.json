{
  "name": "reels-factory",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.499",
    "@remotion/google-fonts": "^4.0.499",
    "@remotion/tailwind-v4": "4.0.499",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.499",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.499",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:meeting": "remotion render GrahaMeeting out/graha-meeting.mp4",
    "render:rahu-ketu": "remotion render RahuKetuOrigin out/rahu-ketu-origin.mp4",
    "render:intro": "remotion render DailyDoseIntro out/daily-dose-intro.mp4",
    "render:format-a": "remotion render RahuKetuFormatA out/format-a-cutout-theater.mp4",
    "render:format-b": "remotion render RahuKetuFormatB out/format-b-slideshow.mp4",
    "render:format-c": "remotion render RahuKetuFormatC out/format-c-puppet-motion.mp4",
    "render:formats": "npm run render:format-a && npm run render:format-b && npm run render:format-c"
  },
  "sideEffects": [
    "*.css"
  ]
}
